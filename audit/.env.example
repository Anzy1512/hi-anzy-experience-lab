# ---------------------------------------------------------------------------
# The audit service. Copy to .env and fill in.
#
# .env is gitignored. Nothing in this file is a real secret and nothing here
# has a working default — a service that crawls the open web and calls a paid
# model should refuse to start rather than run on a placeholder.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=8787

# REQUIRED. At least 32 characters. Generate one, do not invent one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY=

# The corpus.
#
# Leave DATABASE_URL empty to run on PGlite — real Postgres in this process,
# with pgvector, no daemon required. Correct for building; wrong for a crawler
# running continuously, because it is single-connection.
#
# For a server, start the one in docker-compose.yml and use:
#   DATABASE_URL=postgres://audit:audit@127.0.0.1:5433/audit
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# The width the chunk table was BUILT for. Changing it is a migration plus a
# re-embed of every stored chunk, not a setting. 384 = bge-small-en-v1.5.
EMBEDDING_DIM=384

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# Synthesis. Not needed until that layer exists.
ANTHROPIC_API_KEY=

# Discovery. sitemap | searxng | brave | tavily | direct | none
#
# TWO OF THESE NEED NO CREDENTIALS AND ARE THE ONES THAT CAN BE PROVEN:
#
#   sitemap  reads robots.txt, follows the sitemaps it names, and returns the
#            pages a site published to be read. No key, no account, no third
#            party. A site that refuses is reported as a refusal rather than as
#            a site with no pages.
#   direct   URLs you supply. Never touches the network to find them.
#
# The rest are adapters against the same contract and do nothing until a key
# exists. Nothing downstream can tell which provider produced a URL.
#
# SearXNG is the default: self-hosted, nothing per query, and no third party
# receives a log of which companies are being investigated. For an OSINT tool
# that last point is not a detail.
#
# IMPORTANT: most SearXNG instances ship with JSON DISABLED, and a JSON request
# against one returns an HTML page with HTTP 200 — which parses as "no results"
# rather than as a fault. Add to the instance's settings.yml:
#
#   search:
#     formats:
#       - html
#       - json
#
# With no provider configured the service still ingests directly supplied URLs.
# That path never touches a search provider and cannot be broken by one.
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://127.0.0.1:8080
# Brave or Tavily use this instead; SearXNG and sitemap need no key.
SEARCH_API_KEY=

# Geography. none (default) | nominatim
#
# `none` is the honest default. A geographic provider is a third party whose
# coordinates get READ rather than merely followed, so switching one on is a
# decision about what the map may assert. With `none`, a business is placed only
# when its own pages publish coordinates and everything else stays visibly
# unplaced.
#
# Nominatim is OpenStreetMap's gazetteer: no key, no account. It names
# businesses in an area and resolves an address to a point, and it records how
# precisely — a match that reached only a town centre is stored as unresolved
# rather than plotted.
#
# The public instance is donated capacity with a published policy: one request
# per second, and identify yourself. The adapter enforces both. Anything beyond
# a bounded pilot belongs on an instance you host, which is what NOMINATIM_URL
# is for.
PLACE_PROVIDER=none
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Embeddings. deterministic (default) | local
#
# `deterministic` is a hashing projection: free, offline, identical everywhere,
# and NOT semantic — it reports that about itself so a dense index built on it
# is not mistaken for one that understands meaning.
#
# `local` is bge-small-en-v1.5 via @huggingface/transformers, which is not a
# declared dependency. Install it first:
#   npm install @huggingface/transformers
EMBEDDING_PROVIDER=deterministic

# Crawler manners, and the one that is not manners.
#
# CRAWL_ALLOW_PRIVATE_NETWORKS must stay false. With it true, any caller who
# can submit a URL can point this service at cloud metadata endpoints or at
# anything else reachable from the network it runs in.
CRAWL_USER_AGENT=hi-anzy-audit/0.1 (+https://hianzy.com; research crawler; contact via site)
CRAWL_RESPECT_ROBOTS=true
CRAWL_ALLOW_PRIVATE_NETWORKS=false
CRAWL_PER_HOST_RPS=0.5
CRAWL_MAX_BYTES=2500000
CRAWL_TIMEOUT_MS=20000
